# server-provisioning/.env.example
#
# Copy to .env in this directory (or export these as real environment
# variables before running provision.sh) and fill in the values.
# .env itself must never be committed — it is gitignored.

# REQUIRED. The operator's SSH public key, added to the admin user's
# authorized_keys. Must be Ed25519 (docs/ARCHITECTURE.md Section 2.2) —
# provision.sh refuses to run without a valid value here, because SSH
# password auth gets disabled and a missing/wrong key would lock you out.
# Generate one with: ssh-keygen -t ed25519 -C "you@yourdevice"
CCR_ADMIN_PUBKEY=

# OPTIONAL but recommended. admin's sudo is password-gated (not NOPASSWD —
# see provision.sh step_admin_sudo for why), so admin cannot use sudo until
# a password exists. Set this to a crypt hash, NEVER a plaintext password —
# provision.sh rejects any value that doesn't start with '$'. Generate one
# with: openssl passwd -6
# If left empty, provisioning still succeeds but prints a loud warning: run
# `passwd admin` on the server yourself before closing the root session.
CCR_ADMIN_PASSWORD_HASH=

# SSH login user, kept separate from the agent user so a compromised agent
# session doesn't come with full SSH/admin privileges.
CCR_ADMIN_USER=admin

# Dedicated non-root user that runs all coding agents and terminal sessions.
CCR_AGENT_USER=agent

# sshd listens here instead of 22.
CCR_SSH_PORT=2222

# Tailscale auth key for unattended `tailscale up`. Leave empty to install
# Tailscale without authenticating — you'll run `tailscale up` manually.
CCR_TAILSCALE_AUTHKEY=

# Set to 1 to skip the Tailscale step entirely (e.g. in a test container).
CCR_SKIP_TAILSCALE=0

# OPTIONAL, but required before any device can pair. The public domain this
# installation is reachable at through CloudGate (server-provisioning/cloudgate/
# SETUP.md), e.g. remote.your-domain.example. This project ships no default —
# every installation has its own domain, and the daemon uses it as the
# WebAuthn relying-party ID: it is what every passkey gets cryptographically
# bound to. Set it ONCE, before the first device pairs. Changing it later
# invalidates every passkey already registered, with no way to undo that.
# Leaving it empty is safe and supported — the daemon still starts, it just
# keeps the passkey pairing factor permanently disabled (fail-closed, not a
# workaround) until this is set.
CCR_PUBLIC_DOMAIN=

# Address the daemon listens on. Loopback is correct only when CloudGate runs
# on this same machine. When CloudGate runs elsewhere — the usual setup — it
# cannot reach 127.0.0.1 here, and this must be an address CloudGate can route
# to: normally this machine's Tailscale IP. It must match the target you
# register in CloudGate. A wildcard (0.0.0.0) is refused outright.
#CCR_BIND_ADDR=127.0.0.1:8080