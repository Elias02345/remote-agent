# ClaudeCode Remote Samba configuration (docs/ARCHITECTURE.md Section 7.1).
# Generated by install-files-backups.sh — edits here are overwritten.
#
# The two interface lines below are the entire reason this file is safe to
# have at all. SMB is not a protocol to expose to the internet, encrypted or
# not, so the shares are offered ONLY on the Tailscale interface. Removing
# either line, or adding a public interface, puts the backup archive and every
# project file on the open network.

[global]
   workgroup = WORKGROUP
   server string = ClaudeCode Remote
   server role = standalone server

   interfaces = lo @@TAILSCALE_IFACE@@
   bind interfaces only = yes

   # SMB3 with mandatory transport encryption. This is the reason SMB was
   # chosen over NFS: NFSv3 without Kerberos is unencrypted and authorises
   # essentially by IP address, which is too low a bar for a share holding
   # backups and source code.
   server min protocol = SMB3
   smb encrypt = required

   # No guest access, ever. A share reachable without credentials on a mesh
   # network is still a share reachable by anything that joins the mesh.
   map to guest = never
   restrict anonymous = 2

   log file = /var/log/samba/%m.log
   max log size = 1000

[backups]
   comment = ClaudeCode Remote backups (read-only)
   path = /srv/backups
   browseable = yes
   # Read-only on purpose: this is where restic snapshots live, and a client
   # with write access could delete the backups it is supposed to protect.
   read only = yes
   valid users = @@SMB_USER@@

[exchange]
   comment = Agent exchange directory
   path = /srv/exchange
   browseable = yes
   read only = no
   create mask = 0644
   directory mask = 0755
   valid users = @@SMB_USER@@
