[Unit]
Description=ClaudeCode Remote terminal session daemon
Documentation=https://github.com/Elias02345/remote-agent/wiki/Terminal-Daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=agent
Group=agent

# Defaults first, then the operator's file, so .env overrides these rather than
# the other way round. systemd applies Environment= and EnvironmentFile= in the
# order they appear.
#
# CCR_BIND_ADDR matters more than it looks. Loopback is right only when
# CloudGate runs on this same machine. CloudGate normally runs elsewhere, and
# from there 127.0.0.1 is CloudGate's own host — it can never reach this
# daemon. In that topology this must be an address CloudGate can actually
# connect to, which is the Tailscale IP. The daemon refuses a wildcard bind
# either way.
Environment=CCR_BIND_ADDR=127.0.0.1:8080
Environment=CCR_PUBLIC_DOMAIN=
Environment=CCR_OWNER_EMAIL=
Environment=CCR_OWNER_PASSWORD_HASH=
Environment=CCR_OWNER_TOTP_SECRET=

# Secrets and per-installation configuration live here, never in this unit and
# never on the command line: a flag value is visible to every local user in the
# process table. The leading '-' means a missing file is not fatal — the daemon
# is fail-closed without those values rather than refusing to boot.
EnvironmentFile=-/etc/claudecode-remote/.env

# Every flag uses the --flag=${VAR} form, never --flag ${VAR}.
#
# systemd expands an unset or empty variable to *zero words*, so the space form
# would hand the next argument to the previous flag: with no domain configured,
# `--public-domain ${CCR_PUBLIC_DOMAIN} --owner-email ...` reaches the daemon as
# `--public-domain=--owner-email`. The equals form yields `--public-domain=`,
# an honest empty value. Unset is the default state of a fresh install, so this
# is the normal path, not an edge case.
ExecStart=/usr/local/bin/claudecode-remoted \
    --addr=${CCR_BIND_ADDR} \
    --db=/var/lib/claudecode-remote/daemon.db \
    --lock-dir=/run/claudecode-locks \
    --file-roots=/srv/exchange \
    --upload-dir=/var/lib/claudecode-remote/uploads \
    --public-domain=${CCR_PUBLIC_DOMAIN} \
    --owner-email=${CCR_OWNER_EMAIL} \
    --owner-password-hash=${CCR_OWNER_PASSWORD_HASH} \
    --owner-totp-secret=${CCR_OWNER_TOTP_SECRET}

Restart=always
RestartSec=5

# Modest hardening only. The daemon spawns tmux, writes lock files under /run
# and user data under /srv, so the aggressive sandboxing options (PrivateTmp,
# ProtectHome, a strict ReadWritePaths list) would break it in ways that only
# show up when someone opens a terminal — worse than not setting them.
NoNewPrivileges=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

# tmux sessions are the point of this service and must survive a restart of it.
# KillMode=process stops the daemon without taking its process group with it.
KillMode=process

[Install]
WantedBy=multi-user.target
